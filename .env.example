NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=Get from https://dashboard.clerk.com/apps
CLERK_SECRET_KEY=Get from https://dashboard.clerk.com/apps
FIREBASE_API_KEY=Get from https://console.firebase.google.com/project/_/settings/general/
FIREBASE_AUTH_DOMAIN=Get from https://console.firebase.google.com/project/_/settings/general/
FIREBASE_PROJECT_ID=Get from https://console.firebase.google.com/project/_/settings/general/
FIREBASE_STORAGE_BUCKET=Get from https://console.firebase.google.com/project/_/settings/general/
FIREBASE_MESSAGING_SENDER_ID=Get from https://console.firebase.google.com/project/_/settings/general/
FIREBASE_APP_ID=Get from https://console.firebase.google.com/project/_/settings/general/
FIREBASE_MEASUREMENT_ID=Get from https://console.firebase.google.com/project/_/settings/general/
NEXT_PUBLIC_FIREBASE_API_KEY=Get from https://console.firebase.google.com/project/_/settings/general/
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=Get from https://console.firebase.google.com/project/_/settings/general/
NEXT_PUBLIC_FIREBASE_PROJECT_ID=Get from https://console.firebase.google.com/project/_/settings/general/
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=Get from https://console.firebase.google.com/project/_/settings/general/
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=Get from https://console.firebase.google.com/project/_/settings/general/
NEXT_PUBLIC_FIREBASE_APP_ID=Get from https://console.firebase.google.com/project/_/settings/general/
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=Get from https://console.firebase.google.com/project/_/settings/general/
# Firebase Admin SDK — from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# =============================================================================
# Encryption — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================
USER_KEY_ENCRYPTION_SECRET=

# =============================================================================
# AI Providers — server-side only, never prefix with NEXT_PUBLIC_
# =============================================================================

# Default server-side provider — only Gemini key lives here.
# All other providers (OpenAI, Groq, OpenRouter, Custom) use keys
# entered by the user in AI Settings and stored encrypted in Firestore.
AI_DEFAULT_PROVIDER=gemini

# --- Gemini (server default, free tier) ---
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash
GEMINI_AUTOCOMPLETE_MODEL=gemini-2.0-flash-lite

# Embedding model (free tier: ~5 RPM — set AI_ENABLE_EMBEDDINGS=false to use keyword search only)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_ENABLE_EMBEDDINGS=false

# =============================================================================
# RAG / Embeddings — for Ask Notes feature
# =============================================================================

# Embeddings always use server Gemini key (not user keys)
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=text-embedding-004

# =============================================================================
# App feature flags
# =============================================================================

# Allow users to supply their own API keys in settings (true | false)
AI_ALLOW_USER_KEYS=true

# Autocomplete debounce in ms
AI_AUTOCOMPLETE_DEBOUNCE_MS=700

# Max tokens for autocomplete suggestion
AI_AUTOCOMPLETE_MAX_TOKENS=80

# Max tokens for summary
AI_SUMMARY_MAX_TOKENS=300

# Max tokens for rewrite
AI_REWRITE_MAX_TOKENS=4096

# Max notes to retrieve for RAG context
AI_RAG_TOP_K=5